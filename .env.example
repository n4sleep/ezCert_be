# ---- processor (.NET 8) ----
ConnectionStrings__Default=Host=localhost;Port=5432;Database=ezcert;Username=ezcert;Password=ezcert
ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development

# Database provider: postgres (local/prod) | sqlite (fallback)
Database__Provider=postgres
Database__SqlitePath=/data/ezcert.db

# Bedrock access: gateway (hosted, via rich sandbox) | direct (local SSO)
Bedrock__Mode=gateway
BedrockGateway__Url=https://gvqfk9rm2t.us-east-1.awsapprunner.com
BedrockGateway__Secret=ezcert-gateway-2026-demo

# AWS / Bedrock (dev uses SSO profile via env; prod uses App Runner IAM role)
AWS_PROFILE=AWSPowerUserAccess-400422680681
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Qdrant
Qdrant__Host=localhost
Qdrant__Port=6333
Qdrant__Https=false

# ---- crawler (TypeScript) ----
CRAWLER_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
CRAWLER_BASE_URL=http://localhost:8081

# ---- frontend (Vite) ----
VITE_API_URL=http://localhost:5080
